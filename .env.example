# BUIA settings. install.ps1 copies this file to .env on the first run.
# .env is git-ignored: it holds your paths and token and is never committed.
# Windows paths: use forward slashes.

# Folder BUIA reads and writes (mounted as workspace/). install.ps1 sets it to the folder above this repo.
BUIA_PATH=C:/Users/YOU/buia

# Extra folder the agent can read but not change (mounted read-only as vault/). install.ps1 points it at <buia>/.obsidian;
# point it at another Obsidian vault if you want the agent to read that. The agent's own notes live in <buia>/memory/.
VAULT_PATH=C:/Users/YOU/buia/.obsidian

# Models are downloaded and selected in the web UI (Models panel), not here.
# Examples for an 8 GB GPU: a 4B model at Q4_K_M / Q5_K_M. Use an instruct model with a tool-calling chat template.

# Context window in tokens. The agent reads the same value and trims history/tool output to fit.
# Bigger = more VRAM for the KV cache. On 8 GB, check nvidia-smi before raising it.
CTX_SIZE=20480

# KV cache precision: q8_0 (half the memory of f16, negligible quality loss), f16, or q4_0 (smallest).
KV_CACHE_TYPE=q8_0

# Web UI password. There is no BUIA_PASSWORD line here on purpose: install.ps1 (and update.ps1) append a random one to .env the
# first time. Change it any time by editing that line, then docker compose up -d (every logged-in browser is logged out).
# Keep $ and # out of it: Compose reads them as syntax. Without a BUIA_PASSWORD line, or with an empty one, nobody can log in.

# Optional: Hugging Face token, only for gated repos. Never commit it.
HF_TOKEN=

# Optional: your VRAM in MiB, only if the Models panel says it cannot read the GPU (e.g. 8151).
GPU_VRAM_MB=

# Optional sampling flags from the model card, e.g. for Qwen3 Instruct-2507:
# LLAMA_EXTRA_ARGS=--temp 0.7 --top-k 20 --top-p 0.8 --min-p 0
LLAMA_EXTRA_ARGS=

# Always-loaded memory: comma-separated paths/globs relative to the virtual root.
MEMORY_FILES=workspace/BUIA.md,workspace/memory/*.md,workspace/memory/Projects/*.md

# IANA timezone for the date in the system prompt (e.g. Europe/London).
TZ=UTC

# Optional: extra host names the web UI may be opened under, comma-separated. localhost, 127.0.0.1 and *.ts.net (Tailscale)
# always work; any other Host header is refused, which stops a web page from reaching the agent through DNS rebinding.
ALLOWED_HOSTS=

# Image/video generation (stable-diffusion.cpp). Only used when started with: .\install.cmd -Sd
# Model files go in sdmodels\ (next to docker-compose.yml); paths below are as seen inside the container.
# Two servers, because one sd-server loads one model: an image model cannot make videos and the other way round.
# SD_ARGS is for images (service sd), SD_VIDEO_ARGS for video (service sd-video). Keep each on a single line.
# --params-backend keeps weights on disk/CPU between jobs, so the two servers can share one 8 GB GPU.
# Images: Z-Image Turbo. Files: z_image_turbo-Q4_0.gguf (leejet/Z-Image-Turbo-GGUF), Qwen3-4B-Instruct-2507-Q4_K_M.gguf (unsloth/Qwen3-4B-Instruct-2507-GGUF), ae.safetensors (Comfy-Org/z_image_turbo, split_files/vae)
SD_ARGS=--diffusion-model /models/z_image_turbo-Q4_0.gguf --vae /models/ae.safetensors --llm /models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf --cfg-scale 1.0 --steps 8 --diffusion-fa --backend clip=cpu,diffusion=CUDA0,vae=CUDA0 --params-backend te=cpu,diffusion=disk,vae=disk --lora-model-dir /models/loras
# Video: Wan 2.1 T2V 1.3B. Files: wan2.1_t2v_1.3B_fp16.safetensors and wan_2.1_vae.safetensors (Comfy-Org/Wan_2.1_ComfyUI_repackaged, split_files/), umt5-xxl-encoder-Q4_K_S.gguf (city96/umt5-xxl-encoder-gguf)
SD_VIDEO_ARGS=--diffusion-model /models/wan2.1_t2v_1.3B_fp16.safetensors --vae /models/wan_2.1_vae.safetensors --t5xxl /models/umt5-xxl-encoder-Q4_K_S.gguf --diffusion-fa --max-vram cuda0=5 --lora-model-dir /models/loras --backend clip=cpu,diffusion=CUDA0,vae=CUDA0 --params-backend te=cpu,diffusion=disk,vae=disk
# Video, alternative: Wan 2.2 TI2V 5B. Files: Wan2.2-TI2V-5B-Q4_K_M.gguf and VAE/Wan2.2_VAE.safetensors (unsloth/Wan2.2-TI2V-5B-GGUF), umt5-xxl-encoder-Q4_K_S.gguf as above
# SD_VIDEO_ARGS=--diffusion-model /models/Wan2.2-TI2V-5B-Q4_K_M.gguf --vae /models/Wan2.2_VAE.safetensors --t5xxl /models/umt5-xxl-encoder-Q4_K_S.gguf --cfg-scale 6.0 --sampling-method euler --flow-shift 3.0 --diffusion-fa --max-vram cuda0=5 --lora-model-dir /models/loras --backend clip=cpu,diffusion=CUDA0,vae=CUDA0 --params-backend te=cpu,diffusion=disk,vae=disk