# BUIA settings. install.ps1 copies this file to .env on the first run.
# .env is git-ignored: it holds your paths and token and is never committed.
# Windows paths: use forward slashes.

# Folder BUIA reads and writes (mounted as workspace/). install.ps1 sets it to the folder above this repo.
BUIA_PATH=C:/Users/conta/buia

# Obsidian folder (mounted as vault/).
VAULT_PATH=C:/Users/conta/buia/.obsidian

# Models are downloaded and selected in the web UI (Models panel), not here.
# Examples for an 8 GB GPU: a 4B model at Q4_K_M / Q5_K_M. Use an instruct model with a tool-calling chat template.

# Context window in tokens. The agent reads the same value and trims history/tool output to fit.
# Bigger = more VRAM for the KV cache. On 8 GB, check nvidia-smi before raising it.
CTX_SIZE=20480

# KV cache precision: q8_0 (half the memory of f16, negligible quality loss), f16, or q4_0 (smallest).
KV_CACHE_TYPE=q8_0

# Optional: Hugging Face token, only for gated repos. Never commit it.
HF_TOKEN=

# Optional: your VRAM in MiB, only if the Models panel says it cannot read the GPU (e.g. 8151).
GPU_VRAM_MB=

# Optional sampling flags from the model card, e.g. for Qwen3 Instruct-2507:
# LLAMA_EXTRA_ARGS=--temp 0.7 --top-k 20 --top-p 0.8 --min-p 0
LLAMA_EXTRA_ARGS=

# Always-loaded memory: comma-separated paths/globs relative to the virtual root.
MEMORY_FILES=workspace/BUIA.md,workspace/.obsidian/*.md,workspace/.obsidian/projects/*.md

# IANA timezone for the date in the system prompt (e.g. Europe/London).
TZ=UTC

# Image/video generation (stable-diffusion.cpp). Only used when started with: .\install.ps1 -Sd
# Model files go in sdmodels\ (next to docker-compose.yml); paths below are as seen inside the container.
# One model at a time: an image model cannot make videos and the other way round. Keep SD_ARGS on a single line.
SD_ARGS=--diffusion-model /models/z_image_turbo-Q4_K.gguf --vae /models/ae.safetensors --llm /models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf --cfg-scale 1.0 --steps 8 --diffusion-fa --backend clip=cpu,diffusion=CUDA0,vae=CUDA0 --params-backend te=cpu,diffusion=disk,vae=disk --lora-model-dir /models/loras
# SD_ARGS=--diffusion-model /models/wan2.1_t2v_1.3B_fp16.safetensors --vae /models/wan_2.1_vae.safetensors --t5xxl /models/umt5-xxl-encoder-Q4_K_S.gguf --diffusion-fa --max-vram cuda0=5 --lora-model-dir /models/loras --backend clip=cpu,diffusion=CUDA0,vae=CUDA0 --params-backend te=cpu,diffusion=disk,vae=disk
